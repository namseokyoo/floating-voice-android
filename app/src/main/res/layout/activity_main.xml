<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="TooManyViews">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/navigation_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigation_back"
            android:padding="12dp"
            android:src="@drawable/ic_quiet_back"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/app_bar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_settings"
            android:padding="12dp"
            android:src="@drawable/ic_quiet_settings"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME: one state message and one primary action. -->
        <ScrollView
            android:id="@+id/home_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="560dp"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="16dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/dashboard_state_content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

                    <ImageView
                        android:id="@+id/dashboard_icon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_quiet_icon"
                        android:contentDescription="@null"
                        android:padding="20dp"
                        android:src="@drawable/ic_quiet_link" />

                    <TextView
                        android:id="@+id/dashboard_eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/home_connect_eyebrow"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboard_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/home_connect_title"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboard_supporting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/home_connect_supporting"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/dashboard_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:drawablePadding="8dp"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="보낼 곳 · @my_hermes_bot" />

                    <LinearLayout
                        android:id="@+id/operation_status_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_quiet_error"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_error_title"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/fv_recording"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/operation_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/operation_status_initial"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dismiss_error"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:text="@string/dismiss_error"
                            android:textColor="@color/fv_recording" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_primary_action"
                    style="@style/FloatingVoice.QuietPrimaryButton"
                    android:text="@string/home_connect_action" />

                <TextView
                    android:id="@+id/dashboard_action_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:minHeight="24dp"
                    android:text="@string/home_connect_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </ScrollView>

        <!-- CONNECTION: only the current resumable step is visible. -->
        <ScrollView
            android:id="@+id/connection_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/connection_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_step_format"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    tools:text="1/4 · Telegram 연결" />

                <TextView
                    android:id="@+id/connection_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/connection_api_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connection_supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/connection_api_supporting"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/connection_settings_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FloatingVoice.SupportingText"
                        android:text="@string/connection_supporting" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/hint_api_id">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/api_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_api_hash"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/api_hash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="noExcludeDescendants"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_phone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/connection_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_start"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="18dp"
                        android:text="@string/button_save_connection" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/authentication_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/auth_status"
                        style="@style/FloatingVoice.StatusText"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/auth_status_initial" />

                    <TextView
                        android:id="@+id/account_status"
                        style="@style/FloatingVoice.SupportingText"
                        android:layout_marginTop="8dp"
                        android:text="@string/account_not_authenticated" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phone_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="@string/hint_phone"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_phone"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/button_submit_phone"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/auth_code_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="@string/hint_auth_code"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/auth_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="noExcludeDescendants"
                            android:inputType="numberPassword"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_code"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/button_submit_auth_code"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="@string/hint_password"
                        android:visibility="gone"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="noExcludeDescendants"
                            android:inputType="textPassword"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_password"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/button_submit_password"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/email_help"
                        style="@style/FloatingVoice.SupportingText"
                        android:layout_marginTop="14dp"
                        android:text="@string/email_help"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/email_address_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_email_address"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="noExcludeDescendants"
                            android:inputType="textEmailAddress"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_email_address"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/button_submit_email_address"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/email_code_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_email_code"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="noExcludeDescendants"
                            android:inputType="textPassword"
                            android:saveEnabled="false"
                            tools:ignore="TextFields" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_email_code"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="10dp"
                        android:text="@string/button_submit_email_code"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/authentication_complete"
                        style="@style/FloatingVoice.SupportingText"
                        android:layout_marginTop="14dp"
                        android:text="@string/authentication_waiting" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restart_auth"
                        style="@style/FloatingVoice.QuietOutlinedButton"
                        android:layout_marginTop="16dp"
                        android:text="@string/button_retry_connection"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/target_permissions_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/target_step"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/target_status"
                            style="@style/FloatingVoice.SupportingText"
                            android:text="@string/target_not_confirmed" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/hint_bot_username">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/bot_username"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resolve_bot"
                            style="@style/FloatingVoice.QuietPrimaryButton"
                            android:layout_marginTop="14dp"
                            android:text="@string/button_confirm_target" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/permission_step"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/permission_status"
                            style="@style/FloatingVoice.SupportingText"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/permission_overlay_initial" />

                        <View style="@style/FloatingVoice.QuietDivider" />

                        <TextView
                            android:id="@+id/permission_microphone_status"
                            style="@style/FloatingVoice.SupportingText"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/permission_microphone_initial" />

                        <View style="@style/FloatingVoice.QuietDivider" />

                        <TextView
                            android:id="@+id/permission_notification_status"
                            style="@style/FloatingVoice.SupportingText"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/permission_notification_initial" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/permissions"
                            style="@style/FloatingVoice.QuietPrimaryButton"
                            android:layout_marginTop="16dp"
                            android:text="@string/home_permission_action" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/connection_complete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_quiet_icon"
                        android:contentDescription="@null"
                        android:padding="20dp"
                        android:src="@drawable/ic_quiet_mic" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connection_done"
                        style="@style/FloatingVoice.QuietPrimaryButton"
                        android:layout_marginTop="28dp"
                        android:text="@string/button_back_home" />
                </LinearLayout>

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingTop="16dp"
                    android:text="@string/operation_status_initial"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>

        <!-- SETTINGS: infrequent preferences and account actions. -->
        <ScrollView
            android:id="@+id/settings_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/settings_appearance"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/language_selector_label"
                    style="@style/FloatingVoice.FieldLabel"
                    android:labelFor="@id/language_selector"
                    android:text="@string/language_label" />

                <Spinner
                    android:id="@+id/language_selector"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/language_options" />

                <View
                    style="@style/FloatingVoice.QuietDivider"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/overlay_size_selector_label"
                    style="@style/FloatingVoice.FieldLabel"
                    android:labelFor="@id/overlay_size_selector"
                    android:text="@string/overlay_size_label" />

                <Spinner
                    android:id="@+id/overlay_size_selector"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/overlay_size_options" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/settings_telegram"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connection_settings_toggle"
                    style="@style/FloatingVoice.QuietOutlinedButton"
                    android:text="@string/settings_api_info" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_api_info_supporting"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logout"
                    style="@style/FloatingVoice.QuietOutlinedButton"
                    android:layout_marginTop="28dp"
                    android:text="@string/button_logout"
                    android:textColor="?attr/colorError"
                    app:strokeColor="?attr/colorError" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
