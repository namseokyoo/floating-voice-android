<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:importantForAutofill="noExcludeDescendants"
    android:padding="16dp"
    android:saveEnabled="false"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_composer_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/text_composer_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_composer_close" />
        </LinearLayout>

        <com.sidequestlab.floatingvoice.TextComposerEditText
            android:id="@+id/text_composer_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:freezesText="false"
            android:gravity="top|start"
            android:hint="@string/text_composer_hint"
            android:importantForAutofill="noExcludeDescendants"
            android:imeOptions="flagNoPersonalizedLearning"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="8"
            android:minLines="3"
            android:saveEnabled="false"
            android:scrollbars="vertical" />
    </LinearLayout>
</FrameLayout>
