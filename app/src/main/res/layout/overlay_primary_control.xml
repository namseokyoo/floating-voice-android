<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_primary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:importantForAccessibility="auto"
    android:theme="@style/Theme.FloatingVoice.OverlayMaterial3">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/overlay_idle_action"
        android:layout_width="@dimen/overlay_fab_size"
        android:layout_height="@dimen/overlay_fab_size"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text=""
        app:backgroundTint="@color/fv_primary_container"
        app:icon="@drawable/ic_overlay_mic"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:iconTint="@color/fv_on_primary_container"
        app:shapeAppearance="@style/ShapeAppearance.FloatingVoice.Fab" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/overlay_recording_dock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fv_surface_container_high"
        app:cardElevation="6dp"
        app:shapeAppearance="@style/ShapeAppearance.FloatingVoice.Dock"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/overlay_recording_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_stop_send"
                android:layout_width="@dimen/overlay_stop_size"
                android:layout_height="@dimen/overlay_stop_size"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:accessibilityTraversalBefore="@id/overlay_cancel"
                app:backgroundTint="@color/fv_recording"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_overlay_stop"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/fv_on_recording" />

            <LinearLayout
                android:id="@+id/overlay_drag_region"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:focusable="true"
                android:gravity="center_vertical"
                android:importantForAccessibility="yes"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/overlay_live_dot" />

                    <TextView
                        android:id="@+id/overlay_recording_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overlay_recording_status"
                        android:importantForAccessibility="no"
                        android:textColor="@color/fv_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/overlay_recording_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_timer_initial"
                    android:importantForAccessibility="no"
                    android:textColor="@color/fv_on_surface_variant"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_cancel"
                android:accessibilityTraversalAfter="@id/overlay_stop_send"
                android:layout_width="@dimen/overlay_cancel_size"
                android:layout_height="@dimen/overlay_cancel_size"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                app:backgroundTint="@color/fv_cancel_container"
                app:icon="@drawable/ic_overlay_cancel"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/fv_on_cancel_container"
                app:shapeAppearance="@style/ShapeAppearance.FloatingVoice.Cancel" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
