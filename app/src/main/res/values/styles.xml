<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FloatingVoice" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/quiet_primary</item>
        <item name="colorOnPrimary">@color/quiet_on_primary</item>
        <item name="colorPrimaryContainer">@color/quiet_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/quiet_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/quiet_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/quiet_on_secondary_container</item>
        <item name="colorSurface">@color/quiet_surface</item>
        <item name="colorSurfaceContainer">@color/quiet_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/quiet_surface_container_high</item>
        <item name="colorOnSurface">@color/quiet_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/quiet_on_surface_variant</item>
        <item name="colorOutline">@color/quiet_outline</item>
        <item name="colorOutlineVariant">@color/quiet_outline_variant</item>
        <item name="colorError">@color/quiet_recording</item>
        <item name="colorOnError">@color/quiet_on_recording</item>
        <item name="colorErrorContainer">@color/quiet_recording_container</item>
        <item name="colorOnErrorContainer">@color/quiet_recording</item>
        <item name="android:navigationBarColor">@color/quiet_surface</item>
        <item name="android:statusBarColor">@color/quiet_surface</item>
        <item name="android:windowBackground">@color/quiet_surface</item>
    </style>

    <style name="Theme.FloatingVoice.TextComposer" parent="Theme.FloatingVoice.OverlayMaterial3">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FloatingVoice.DestinationPicker" parent="Theme.FloatingVoice.TextComposer">
        <item name="android:windowSoftInputMode">adjustNothing</item>
    </style>

    <!-- Overlay/composer theme keeps its v0.5.0 fixed semantic tokens. -->
    <style name="Theme.FloatingVoice.OverlayMaterial3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fv_primary</item>
        <item name="colorOnPrimary">@color/fv_on_primary</item>
        <item name="colorPrimaryContainer">@color/fv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fv_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/fv_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fv_on_secondary_container</item>
        <item name="colorSurface">@color/fv_surface</item>
        <item name="colorSurfaceContainer">@color/fv_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/fv_surface_container_high</item>
        <item name="colorOnSurface">@color/fv_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/fv_on_surface_variant</item>
        <item name="colorOutline">@color/fv_outline</item>
        <item name="colorError">@color/fv_recording</item>
        <item name="colorOnError">@color/fv_on_recording</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="ShapeAppearance.FloatingVoice.Fab" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.FloatingVoice.Dock" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.FloatingVoice.Cancel" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="FloatingVoice.QuietPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="FloatingVoice.QuietOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="FloatingVoice.QuietDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="FloatingVoice.StatusText" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="FloatingVoice.SupportingText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="FloatingVoice.FieldLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>


</resources>
